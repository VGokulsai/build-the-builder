     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "cardNumber"
        ],
        "properties": {
         "cardNumber": {
          "type": "string"
         },
         "data": {
          "type": "object"
         },
         "call": {
          "type": "object"
         }
        }
       }
      }
     }
    }
   }
  },
  "/statement.week.get": {
   "post": {
    "operationId": "statement_week_get",
    "summary": "5.3 current statement week",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "cardNumber"
        ],
        "properties": {
         "cardNumber": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "/statement.week.decide": {
