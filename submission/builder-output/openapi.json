  },
  "/statement.pdf.send": {
   "post": {
    "operationId": "statement_pdf_send",
    "summary": "5.7 send the statement PDF",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "customerNo",
         "cardNumber",
         "currencyType",
         "statementDate",
         "emailAddress"
        ],
        "properties": {
         "customerNo": {
          "type": "string"
         },
         "cardNumber": {
          "type": "string"
         },
         "currencyType": {
          "type": "string",
          "enum": [
           "TL",
           "USD",
           "EUR",
           "GBP"
          ]
         },
         "statementDate": {
          "type": "string"
         },
         "emailAddress": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  }
