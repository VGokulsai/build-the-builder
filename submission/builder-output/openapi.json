    "operationId": "statement_week_decide",
    "summary": "5.4 preview of a new week",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "cardNumber",
         "newStatementWeek",
         "statementDay"
        ],
        "properties": {
         "cardNumber": {
          "type": "string"
         },
         "newStatementWeek": {
          "type": "string",
          "enum": [
           "1",
           "2",
           "3",
           "4"
          ]
         },
         "statementDay": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "/statement.week.change": {
   "post": {
    "operationId": "statement_week_change",
    "summary": "5.5 change the statement week",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "cardNumber",
         "newStatementWeek",
         "statementDay"
        ],
        "properties": {
         "cardNumber": {
          "type": "string"
         },
         "newStatementWeek": {
          "type": "string",
          "enum": [
           "1",
           "2",
           "3",
           "4"
          ]
         },
         "statementDay": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "/contact.email.get": {
   "post": {
    "operationId": "contact_email_get",
    "summary": "5.6 registered e-mail",
    "requestBody": {
